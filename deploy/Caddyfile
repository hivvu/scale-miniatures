# The web half of the stack, inside the container. It listens on plain HTTP on port 80 and is never
# published to the host: cloudflared reaches it over the compose network, so no port on the machine is
# taken and nothing is exposed to the network the machine sits on.

:80 {
	encode zstd gzip
	root * /srv/site

	# One address for one site. Two hostnames serving the same pages is duplicate content, and the
	# canonical tag only papers over it; a 301 settles it. This has to be a `handle` and it has to come
	# first: a bare `redir` is sorted by Caddy's own directive order and loses to the handles below.
	@www host www.scaleminiatures.fun
	handle @www {
		redir https://scaleminiatures.fun{uri} permanent
	}

	# The relay, above the poll: `handle /api/*` below is a catch-all and would swallow this. Caddy carries
	# the WebSocket upgrade through reverse_proxy on its own, so there is nothing else to say about it.
	handle /api/relay* {
		reverse_proxy relay:8788
	}

	# The poll service, the other container in the stack.
	handle /api/* {
		reverse_proxy poll:8787
	}

	# The game's own files, mounted read-only from outside the site directory so that rebuilding the site
	# cannot touch them and copying the site cannot carry them along.
	handle /MicroMac/* {
		root * /srv/game
		uri strip_prefix /MicroMac
		file_server
	}

	handle {
		# Hashed file names, so they can be cached until the heat death of the universe.
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		header /fonts/* Cache-Control "public, max-age=31536000, immutable"
		# The entry points are not hashed and must not be. Clean URLs have to be listed here by name: the
		# header matcher runs before the rewrite below, so it sees /online and not /online.html.
		header /index.html Cache-Control "no-cache"
		header /*.html Cache-Control "no-cache"
		header /online Cache-Control "no-cache"

		# One page, one address. The file is online.html and the address is /online, so the file name is
		# redirected to the address (301) and the address is rewritten to the file. Caddy runs redir before
		# rewrite, which is the order this needs.
		redir /online.html /online permanent
		@page file {path}.html
		rewrite @page {path}.html

		file_server
	}

	log {
		output stdout
		format console
	}
}
